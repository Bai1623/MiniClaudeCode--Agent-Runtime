{
  "schema_version": 1,
  "id": "redact-nested-secrets",
  "split": "development",
  "task": "扩展配置脱敏函数，使 password、token、secret 字段在任意嵌套字典或列表中都被替换为 ***，且不修改输入对象。",
  "fixture": "nested_redaction",
  "success_criteria": ["递归处理字典和列表", "原输入保持不变", "普通字段完整保留"],
  "graders": [
    {"kind": "no_op", "config": {}},
    {"kind": "fail_to_pass", "config": {"command": ["{python}", "-m", "unittest", "discover"]}},
    {"kind": "pass_to_pass", "config": {"command": ["{python}", "-m", "unittest", "test_redaction.TestRedaction.test_redacts_top_level_secret"]}},
    {"kind": "expected_changes", "config": {"required": ["redaction.py"], "allowed": ["redaction.py"]}},
    {"kind": "forbidden_changes", "config": {"patterns": ["test*.py", ".git/**"]}}
  ],
  "budget": {"max_model_calls": 10, "max_tool_calls": 30, "max_input_tokens": 60000, "max_output_tokens": 12000, "timeout_seconds": 120, "max_cost_usd": 1.2},
  "tags": ["security", "python", "context"]
}
